# Database
DB_URL=jdbc:postgresql://localhost:5432/espacoagil
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server
PORT=8002

# Security - OBRIGATÓRIO em produção
# Chave AES pra criptografia de dados sensíveis. Gerar com OpenSSL:
# openssl rand -base64 32
# ou use um gerenciador de secrets (AWS Secrets Manager, HashiCorp Vault, etc)
APP_ENCRYPTION_SECRET=AgileSpaceDevMasterKey2026LocalOnly#AES

# Admin access key pra endpoint GET /api/users (listagem de usuários)
# Deixar vazio desabilita o endpoint. Em produção, settar valor seguro.
APP_ADMIN_KEY=

# Aplicação
SPRING_PROFILES_ACTIVE=dev
