# Database
DB_URL=jdbc:postgresql://localhost:5432/espacoagil
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server
PORT=8002

# Security - OBRIGATÓRIO em produção
# Chave AES pra criptografia de dados sensíveis. Gerar com OpenSSL:
# openssl rand -base64 32
# ou use um gerenciador de secrets (AWS Secrets Manager, HashiCorp Vault, etc)
APP_ENCRYPTION_SECRET=AgileSpaceDevMasterKey2026LocalOnly#AES

# Segredo HMAC que assina os JWT de sessão - OBRIGATÓRIO em produção (mín. 32 bytes).
# Quem conhece esse valor forja login de qualquer usuário, inclusive ADMIN.
# openssl rand -base64 48
APP_JWT_SECRET=AgileSpaceDevJwtSecret2026LocalOnly#NeverUseInProduction

# Admin access key pra endpoint GET /api/users (listagem de usuários)
# Deixar vazio desabilita o endpoint. Em produção, settar valor seguro.
APP_ADMIN_KEY=

# Origens (separadas por vírgula) autorizadas a chamar a API com credenciais (CORS + WebSocket).
# Em produção, usar o(s) domínio(s) público(s) do frontend — nunca "*".
ALLOWED_ORIGINS=http://localhost:9002

# Restringe POST /api/auth/register a e-mails desse domínio. Vazio = qualquer e-mail (uso em
# dev/teste). Em produção é obrigatório (ex.: totvs.com.br): vazio faz o backend recusar subir.
ALLOWED_EMAIL_DOMAIN=

# Aplicação
SPRING_PROFILES_ACTIVE=dev

# Observabilidade (OpenTelemetry) — agente Java sempre presente na imagem (ver Dockerfile),
# inerte até OTEL_JAVAAGENT_ENABLED=true. Vendor-neutro (OTLP), compatível com SigNoz ou
# qualquer outro backend compatível.
OTEL_JAVAAGENT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
